# Copy the required values into your shell or hosting environment.
# Do not commit real secrets.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# Optional when using a hosted database:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/hrbot?retryWrites=true&w=majority
# Set this to your deployed frontend origin when frontend and API are separate:
# APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# Change seeded demo passwords before deployment:
SEED_ADMIN_PASSWORD=replace-this-admin-password
SEED_EMPLOYEE_PASSWORD=replace-this-employee-password
